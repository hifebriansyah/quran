# Public address of the R2 bucket quran-images (the verse pictures). Same value locally and in production.
# Used by the site build; nothing secret goes in a VITE_ variable.
VITE_IMAGE_BASE=https://quran-img.situs.id
# Where the shalat page reads its prayer times (sent by tools/upload_shalat.py). Leave unset to use this address.
# VITE_SHALAT_BASE=https://quran-img.situs.id/shalat_schedule
